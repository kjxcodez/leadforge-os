{
  "extends": "../../tsconfig.json",

  "compilerOptions": {
    "jsx": "react-jsx",

    "lib": ["ES2023", "DOM", "DOM.Iterable"],

    "types": ["node"],

    "outDir": "dist",

    "rootDir": ".",

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },

  "references": [
    { "path": "../../packages/sdk" },
    { "path": "../../packages/core" },
    { "path": "../../packages/schema" }
  ],

  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/renderer/**/*",
    "src/shared/**/*",
    "electron.vite.config.js"
  ]
}
