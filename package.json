{
  "name": "leadforge",
  "description": "LeadForge OS Monorepo — Desktop lead discovery, CRM, and outreach platform",
  "author": "kjxcodez <https://github.com/kjxcodez>",
  "private": true,
  "version": "1.1.1-beta.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "doctor": "npx tsx scripts/doctor.ts",
    "test:ai": "npx tsx scripts/test-ai.ts",
    "release:check": "npx tsx scripts/release-check.ts",
    "verify:production": "npx tsx scripts/verify-production.ts",
    "bump-version": "node scripts/bump-version.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.7.4",
    "turbo": "^2.10.3",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.65.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "mongodb": "7.5.0"
    }
  }
}
